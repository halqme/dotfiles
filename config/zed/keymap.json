[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-'": "task::Spawn",
      "f1": "command_palette::Toggle"
    }
  },
  {
    "context": "(Workspace && !Terminal)",
    "bindings": {
      "cmd-shift-r": "task::Spawn"
    }
  },
  {
    "context": "Editor",
    "bindings": {},
    "unbind": {
      "alt-cmd-shift-down": "editor::FindAllReferences"
    }
  },
  {
    "unbind": {
      "cmd-q": "zed::Quit"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-enter": "assistant::InlineAssist"
    }
  }
]
