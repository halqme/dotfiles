# Load an age-encrypted dotenv file: use_age [file]
use_age() {
  local encrypted_file="${1:-.env.age}"
  local tmp_file
  local status

  [ -f "$encrypted_file" ] || return 0

  watch_file "$encrypted_file"
  tmp_file="$(mktemp)"

  if ! age \
    --decrypt \
    -i "$HOME/.config/age/identity.age" \
    "$encrypted_file" \
    > "$tmp_file"
  then
    rm -f "$tmp_file"
    return 1
  fi

  dotenv "$tmp_file"
  status=$?

  rm -f "$tmp_file"
  return "$status"
}

# Load a flake dev shell without stdenv function bodies.
# Those helpers use bash 4's `;&`, which macOS /bin/bash 3.2 cannot parse.
# Runtime only needs the variable assignments and shellHook.
use_flake() {
  local layout result
  watch_file flake.nix
  watch_file flake.lock
  layout="$(direnv_layout_dir)"
  mkdir -p "$layout"
  result="$(nix --extra-experimental-features "nix-command flakes" print-dev-env --profile "$layout/flake-profile" "$@")" || return $?
  result="$(printf '%s\n' "$result" | awk '
    /^[A-Za-z_][A-Za-z0-9_]* \(\)$/ { skip = 1; next }
    skip && /^\{$/ { next }
    skip && /^}$/ { skip = 0; next }
    skip { next }
    { print }
  ')"
  eval "$result"
  # refresh the gcroot mtime so age-based GC (e.g. nh clean) keeps it; -h because the target is in the read-only store
  touch -h "$layout/flake-profile"
  nix --extra-experimental-features "nix-command flakes" profile wipe-history --profile "$layout/flake-profile"
}
